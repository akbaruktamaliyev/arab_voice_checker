# QRaft — pretty URL for dynamic QR codes.
# Maps /q/{code} to q.php?c={code}. Requires Apache mod_rewrite (on by
# default in Laragon/XAMPP). On nginx, add an equivalent rewrite instead.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /q/ABC123  ->  q.php?c=ABC123  (also allows - and _ in custom codes)
    RewriteRule ^q/([A-Za-z0-9_-]+)/?$ q.php?c=$1 [L,QSA]

    # /b/my-page  ->  b.php?s=my-page  (public bio pages)
    RewriteRule ^b/([A-Za-z0-9_-]+)/?$ b.php?s=$1 [L,QSA]

    # /robots.txt and /sitemap.xml are generated so they use your base_url
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# Don't serve the raw config or SQL even if the web root is misconfigured.
<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>
